  "unimplemented_indexed_rules": [
    {
      "id": "berserk_fury_ee_compatibility",
      "status": "implemented_with_pdf_conflict_note",
      "structured_row": "expert_skill_implementation_table:Berserk Fury",
      "source": "Four Against the Abyss p.15; Four Against Darkness Expanded Edition Barbarian rage p.24",
      "current_behavior": "Abyss says a barbarian with Berserk Fury may use rage attack twice per adventure and not for ranged attacks. Because Expanded Edition already gives barbarians scaling rage uses, the engine preserves the EE class rule and applies Berserk Fury as +1 extra melee rage use.",
      "next_action": "If a stricter source-priority policy is chosen later, revisit whether Abyss should replace or modify the Expanded Edition rage-use count."
    }
  ],
  "rejected_indexed_rules": [
    {
      "id": "capture_ranger_clue_reduction",
      "status": "rejected_false_positive",
      "structured_row": "gap_analysis:capture_ranger_clue_reduction",
      "source": "Four Against Darkness Expanded Edition p.102 (captive_hideout clue spend); ranger class text p.58",
      "current_behavior": "Captive hideout discovery costs 3 Clues per clue_spends_table with no ranger discount. EE p.62 is Swashbuckler traits, not ranger capture. classes.json ranger grants +L to Climbing, Tracking, and Swimming Saves only.",
      "next_action": "Do not implement unless a verbatim ranger hideout Clue discount is found in an approved PDF."
    }
  ]
