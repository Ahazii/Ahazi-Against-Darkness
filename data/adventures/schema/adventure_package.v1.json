{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ahazi-against-darkness/adventure_package.v1.json",
  "title": "Ahazi Against Darkness Adventure Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "title", "source", "capabilities"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_pdf"],
      "properties": {
        "type": {
          "const": "pdf"
        },
        "source_pdf": {
          "type": "string",
          "description": "User-facing DATA_DIR-relative source PDF path, for example Adventure PDFs/example.pdf."
        },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "license_note": {
          "type": "string"
        }
      }
    },
    "adventure_manifest_id": {
      "type": "string",
      "description": "Optional installed adventure.json id that uses this package."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": ["foes", "classes", "items", "tables", "trackers", "procedures", "states", "rules", "maps", "pins", "artwork"]
      },
      "uniqueItems": true
    },
    "foes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      },
      "description": "Experimental until class abilities, advancement, equipment, and UI hooks are manually checked against the PDF."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      }
    },
    "states": {
      "type": "array",
      "description": "Module-local states, conditions, curses, blessings, or other status records that may apply to characters, parties, foes, or items after review.",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      }
    },
    "rules": {
      "type": "array",
      "description": "Module-local rules extracted from the source PDF. These remain review data until explicit app support or manifest conversion uses them.",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      }
    },
    "artwork": {
      "type": "array",
      "description": "Local/private-use artwork extracted from the source PDF into DATA_DIR/Adventures/<module_id>/artwork/extracted for review and later assignment.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "source_pdf", "source_page", "asset_path", "kind", "review_status", "use"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "source_pdf": {
            "type": "string"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "asset_path": {
            "type": "string",
            "description": "Adventure-folder-relative local artwork path, for example artwork/extracted/page-004-image-01.png."
          },
          "kind": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "ignored_records": {
      "type": "array",
      "description": "Candidate records the reviewer marked as wrong or not useful. Kept so importer corrections remain auditable.",
      "items": {
        "$ref": "#/$defs/sourcedRecord"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Human-reviewed rooms, scenes, hexes, or locations extracted from the source PDF before conversion to a playable adventure.json manifest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "source_page", "player_text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "type": {
            "enum": ["room", "scene", "location", "hex", "camp", "settlement", "ending"]
          },
          "title": {
            "type": "string"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "player_text": {
            "type": "string",
            "description": "Reviewed player-facing narrative or boxed/location text. Keep private PDF prose local unless publishing rights are secured."
          },
          "app_notes": {
            "type": "string",
            "description": "Reviewer notes about dice, checks, monsters, rewards, branch conditions, or rules that the app must automate."
          },
          "map_pin_id": {
            "type": "string"
          },
          "foe_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "procedure_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "to"],
              "properties": {
                "label": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "source_text": {
                  "type": "string"
                }
              }
            }
          },
          "review_status": {
            "enum": ["candidate", "draft", "checked", "needs_pdf_check", "ready_for_manifest", "wrong_type", "ignored"]
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source_page", "rows"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "dice": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["result"],
              "properties": {
                "result": {
                  "type": "string"
                }
              }
            }
          },
          "review_status": {
            "enum": ["candidate", "draft", "checked", "needs_pdf_check", "ready_for_manifest", "wrong_type", "ignored"]
          },
          "source_text": {
            "type": "string"
          }
        }
      }
    },
    "trackers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "initial"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "initial": {
            "type": "integer"
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "procedures": {
      "type": "array",
      "description": "Declarative procedure steps only; no JavaScript, Python, shell, or arbitrary expressions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "steps"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["op"],
              "properties": {
                "op": {
                  "enum": [
                    "roll_table",
                    "spawn_foes",
                    "test_save",
                    "grant_gold",
                    "grant_item",
                    "set_tracker",
                    "advance_tracker",
                    "branch_if",
                    "transition_to_node",
                    "complete_objective",
                    "pin_location",
                    "show_choice"
                  ]
                }
              }
            }
          },
          "review_status": {
            "enum": ["candidate", "draft", "checked", "needs_pdf_check", "ready_for_manifest", "wrong_type", "ignored"]
          },
          "source_text": {
            "type": "string"
          }
        }
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source_pdf", "source_page", "asset_path", "coordinate_system", "pins"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "source_pdf": {
            "type": "string"
          },
          "source_page": {
            "type": "integer",
            "minimum": 0
          },
          "asset_path": {
            "type": "string",
          "description": "Adventure-folder-relative local asset path, for example maps/level-1.png inside DATA_DIR/Adventures/<adventure_id>/."
          },
          "coordinate_system": {
            "const": "percent"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "node_id", "x", "y", "shape"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "label": {
                  "type": "string"
                },
                "role": {
                  "enum": ["location", "room", "entrance", "exit", "stairs", "secret", "objective", "camp", "settlement", "other"],
                  "description": "Review marker role used by the map editor. Entrance, exit, stairs, secret, objective, camp, and settlement are metadata until the playable manifest uses them."
                },
                "node_id": {
                  "type": "string",
                  "description": "Room, hex, scene, or location id in the reviewed manifest."
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "shape": {
                  "enum": ["point", "rect", "circle", "polygon"]
                },
                "notes": {
                  "type": "string",
                  "description": "Optional reviewer note about the source label, door, entrance, exit, staircase, or objective marker."
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourcedRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "source_page"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string"
        },
        "source_page": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
