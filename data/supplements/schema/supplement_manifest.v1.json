{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ahazi-against-darkness/supplement_manifest.v1.json",
  "title": "Ahazi Against Darkness Supplement Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "status",
    "locked",
    "enabled_by_default",
    "source",
    "capabilities",
    "dependencies",
    "conflicts",
    "legacy_mappings",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "core_rules",
        "rules_expansion",
        "adventure",
        "campaign",
        "tile_pack",
        "terrain_pack",
        "imported_pdf",
        "local_user"
      ]
    },
    "status": {
      "enum": [
        "active",
        "review_only",
        "planned",
        "deprecated"
      ]
    },
    "locked": {
      "type": "boolean"
    },
    "enabled_by_default": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["pdf", "local_user", "packaged_data"]
        },
        "source_pdf": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "foes",
          "classes",
          "items",
          "tables",
          "states",
          "rules",
          "room_tiles",
          "terrain_types",
          "generators",
          "rules_reference",
          "campaign_state",
          "procedures",
          "locations",
          "narrative",
          "maps",
          "trackers",
          "artwork"
        ]
      }
    },
    "dependencies": {
      "$ref": "#/$defs/stringList"
    },
    "conflicts": {
      "$ref": "#/$defs/stringList"
    },
    "legacy_mappings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stringList"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
