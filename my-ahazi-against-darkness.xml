<?xml version="1.0"?>
<Container version="2">
  <Name>Ahazi Against Darkness</Name>
  <Repository>ghcr.io/ahazii/ahazi-against-darkness:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Ahazii/Ahazi-Against-Darkness</Support>
  <Project>https://github.com/Ahazii/Ahazi-Against-Darkness</Project>
  <Overview>Local dungeon adventure engine with character pool, four-character parties, and persistent sessions.</Overview>
  <Category>Games</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Ahazii/Ahazi-Against-Darkness/main/my-ahazi-against-darkness.xml</TemplateURL>
  <Icon/>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <Memory/>
  <Config Name="Timezone" Target="TZ" Default="Europe/London" Mode="" Description="Container timezone (e.g., Europe/London, America/New_York, UTC)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID to run the container as (Unraid default: 99)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID to run the container as (Unraid default: 100)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="APP_HOST" Target="APP_HOST" Default="0.0.0.0" Mode="" Description="FastAPI host binding" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="APP_PORT" Target="APP_PORT" Default="8000" Mode="" Description="FastAPI port" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="DATA_DIR" Target="DATA_DIR" Default="/data" Mode="" Description="Persistent data path" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Web Port" Target="8000" Default="8001" Mode="tcp" Description="Web UI port" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/ahazi-against-darkness" Mode="rw" Description="Persistent data storage" Type="Path" Display="always" Required="true" Mask="false"/>
</Container>
