<?xml version="1.0"?>
<Container version="2">
  <Name>Ahazi Against Darkness</Name>
  <Repository>ghcr.io/ahazii/ahazi-against-darkness:0.1.0</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Ahazii/Ahazi-Against-Darkness</Support>
  <Project>https://github.com/Ahazii/Ahazi-Against-Darkness</Project>
  <Overview>Four Against Darkness adventure engine.</Overview>
  <Category>Games</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <Memory/>
  <Config Name="APP_HOST" Target="APP_HOST" Default="0.0.0.0" Mode="rw" Description="FastAPI host binding" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="APP_PORT" Target="APP_PORT" Default="8000" Mode="rw" Description="FastAPI port" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="DATA_DIR" Target="DATA_DIR" Default="/data" Mode="rw" Description="Persistent data path" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Web Port" Target="8000" Default="8000" Mode="tcp" Description="Web UI port" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/ahazi-against-darkness" Mode="rw" Description="Persistent data storage" Type="Path" Display="always" Required="true" Mask="false"/>
</Container>
